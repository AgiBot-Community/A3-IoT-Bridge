# LinkSoul 开放平台应用凭证（必须替换）
LINKSOUL_APP_ID=replace-with-linksoul-app-id
LINKSOUL_APP_KEY=replace-with-linksoul-app-key
LINKSOUL_APP_SECRET=replace-with-linksoul-app-secret

# 小鸿 SE HTTP Bearer Token（必须与小鸿 SE 固件配置一致）
XHSE_BEARER_TOKEN=replace-with-xiaohong-se-token

# 千问配置。推荐把 Key 单独存放在仅 agi 用户可读的文件中。
QWEN_KEY_FILE=/agibot/data/home/agi/.secrets/dashscope_api_key
QWEN_MODEL=qwen3.5-omni-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认关闭机器人舞蹈动作。完成现场安全检查后才可改为 true。
A3_DANCE_ENABLED=false

# 一般保持自动发现开启，不需要填写小鸿 SE 的固定 IP。
XHSE_DISCOVERY_ENABLED=true
